{
	"schemaVersion": "0.1.0",
	"name": "YouTube Talk",
	"behavior": "create",
	"noteContentFormat": "# {{title}}\n\n> **Channel:** {{author}} · **URL:** [{{url}}]({{url}}) · **Published:** {{published|date:\"YYYY-MM-DD\"}}\n\n## Description\n\n{{description}}\n\n## Transcript\n\n_Paste transcript here, or run `utilities/prepare.sh` after clipping to backfill it._",
	"properties": [
		{
			"name": "type",
			"value": "Raw",
			"type": "text"
		},
		{
			"name": "source_type",
			"value": "talk",
			"type": "text"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "channel",
			"value": "{{author}}",
			"type": "text"
		},
		{
			"name": "url",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "duration",
			"value": "{{schema:@VideoObject:duration}}",
			"type": "text"
		},
		{
			"name": "published",
			"value": "{{published|date:\\\"YYYY-MM-DD\\\"}}",
			"type": "date"
		},
		{
			"name": "clipped",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "ingested",
			"value": "false",
			"type": "checkbox"
		}
	],
	"triggers": [
		"https://www.youtube.com/watch*",
		"https://youtu.be/*"
	],
	"noteNameFormat": "talk-{{title|safe_name}}",
	"path": "raw"
}
